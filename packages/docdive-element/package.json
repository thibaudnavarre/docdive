{
  "name": "docdive-element",
  "version": "0.3.0",
  "description": "The <docdive-diagram> custom element: interactive Mermaid diagrams backed by a docdive index.",
  "license": "MIT",
  "author": "Thibaud Navarre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thibaudnavarre/docdive.git",
    "directory": "packages/docdive-element"
  },
  "type": "module",
  "exports": {
    ".": "./dist/docdive-element.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "mermaid": ">=11.6 <13"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "mermaid": "^12.3.0"
  }
}
